{
  "name": "family-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Family Tracker mobile app: live family locations, safe zones, alerts and private chat (Expo / React Native).",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "demo": "EXPO_PUBLIC_DEMO_MODE=1 expo start --clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "doctor": "npx expo-doctor",
    "bundle": "expo export --platform android --clear",
    "format": "prettier --write '{app,bootstrap,demo,features,fixtures,shared,__tests__,test-utils,scripts}/**/*.{ts,tsx,js,mjs,json}' '*.{ts,js,mjs,json,cjs}'",
    "format:check": "prettier --check '{app,bootstrap,demo,features,fixtures,shared,__tests__,test-utils,scripts}/**/*.{ts,tsx,js,mjs,json}' '*.{ts,js,mjs,json,cjs}'",
    "dupes": "jscpd",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run dupes"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.1.6",
    "@stripe/stripe-react-native": "0.45.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "expo": "~53.0.27",
    "expo-auth-session": "~6.2.1",
    "expo-battery": "~9.1.4",
    "expo-constants": "~17.1.4",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.0",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-web-browser": "~14.2.0",
    "lucide-react-native": "^0.522.0",
    "query-string": "7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "stream-chat": "^9.8.0",
    "stream-chat-react-native": "^6.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "jscpd": "^5.4.3",
    "prettier": "^3.10.1",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.74.0"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.23",
    "lodash-es": "^4.18.0",
    "decode-uri-component": "^0.5.1"
  }
}
