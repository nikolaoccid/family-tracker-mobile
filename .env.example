# Public configuration only: everything in the app bundle is readable by users.
# Required
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# Optional (features degrade gracefully when missing)
EXPO_PUBLIC_ANDROID_CLIENT_ID=
EXPO_PUBLIC_IOS_CLIENT_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STREAM_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Set to 1 to run against the in-app demo backend (no server needed)
# Set to 0 to stop sending Idempotency-Key (older servers)
EXPO_PUBLIC_IDEMPOTENCY_KEYS=
EXPO_PUBLIC_DEMO_MODE=
# Build-time only (not bundled): path to your own Firebase config file
GOOGLE_SERVICES_FILE=./google-services.json
# Build-time only, for EAS builds under your own account
EXPO_OWNER=
EAS_PROJECT_ID=
